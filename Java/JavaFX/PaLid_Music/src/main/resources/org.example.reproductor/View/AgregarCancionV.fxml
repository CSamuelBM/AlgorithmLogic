<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.reproductor.Controller.AgregarCancionC"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <HBox alignment="CENTER_RIGHT" styleClass="fondo-secundario">
            <Button fx:id="btnAgregar" text="Agregar Canción"
                    onAction="#accionAgregar"
                    styleClass="tb-independiente"/>
        </HBox>

    </top>

    <center>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="fondo-scroll-pane">
            <VBox fx:id="vBox"/>
        </ScrollPane>
    </center>

</BorderPane>
