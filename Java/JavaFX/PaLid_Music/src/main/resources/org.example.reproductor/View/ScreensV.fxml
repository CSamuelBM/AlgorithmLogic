<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="fondo-principal"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.reproductor.Controller.ScreensC">

    <left>
        <VBox alignment="CENTER" styleClass="fondo-secundario"
              prefHeight="400.0" prefWidth="120.0">
            <ToggleButton text="CANCIONES" onAction="#panelCancion" styleClass="izquierda"/>
            <ToggleButton text="BUSCAR" onAction="#panelBuscar" styleClass="izquierda"/>
            <ToggleButton text="FAVORITOS" onAction="#panelFavorito" styleClass="izquierda"/>
            <ToggleButton text="AGREGAR" onAction="#panelAgregarCancion" styleClass="izquierda"/>
            <ToggleButton text="ELIMINAR" onAction="#panelEliminar" styleClass="izquierda"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="stackPane"/>
    </center>

</BorderPane>
