<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.reproductor.Controller.CancionC">

    <top>
        <fx:include fx:id="manipularCancion" source="ManipularCancionV.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" pannable="true"
                    hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    styleClass="fondo-scroll-pane">
                <VBox fx:id="vBox" styleClass="fondo-cancion-v"/>
        </ScrollPane>
    </center>

</BorderPane>
