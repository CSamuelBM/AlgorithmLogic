<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.LoginController"
           styleClass="root-pane"
           stylesheets="@../../CSS/login.css">

    <!-- Fondo rosado -->
    <VBox alignment="CENTER" styleClass="background">

        <!-- Tarjeta principal -->
        <VBox styleClass="card" maxWidth="420" maxHeight="480">

            <!-- Encabezado -->
            <VBox alignment="CENTER" styleClass="card-header">
                <Label text="Bienvenido" styleClass="title"/>
                <Label text="Inicia sesión en tu cuenta" styleClass="subtitle"/>
            </VBox>

            <!-- Formulario -->
            <VBox styleClass="form-section" spacing="16">

                <!-- Campo Email -->
                <VBox spacing="6">
                    <Label text="Correo electrónico" styleClass="field-label"/>
                    <TextField fx:id="emailField"
                               promptText="tu@email.com"
                               styleClass="input-field"/>
                </VBox>

                <!-- Campo Contraseña -->
                <VBox spacing="6">
                    <Label text="Contraseña" styleClass="field-label"/>
                    <PasswordField fx:id="passwordField"
                                  promptText="••••••••"
                                  styleClass="input-field"/>
                </VBox>

                <!-- Recordarme + ¿Olvidaste? -->
                <HBox alignment="CENTER_LEFT" styleClass="options-row">
                    <CheckBox fx:id="rememberMe"
                              text="Recordarme"
                              styleClass="remember-check"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink text="¿Olvidaste tu contraseña?"
                               styleClass="forgot-link"
                               onAction="#onForgotPassword"/>
                </HBox>

                <!-- Botón iniciar sesión -->
                <Button fx:id="loginButton"
                        text="Iniciar sesión"
                        styleClass="login-btn"
                        maxWidth="Infinity"
                        onAction="#onLogin"/>

                <!-- Registro -->
                <HBox alignment="CENTER" spacing="4">
                    <Label text="¿No tienes cuenta?" styleClass="no-account-label"/>
                    <Hyperlink text="Regístrate aquí"
                               styleClass="register-link"
                               onAction="#onRegister"/>
                </HBox>

            </VBox>
        </VBox>
    </VBox>
</StackPane>
